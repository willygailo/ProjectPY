# S1shell Environment Configuration Template
# Copy to .env (or ~/.s1shell/.env) with `chmod 600` and fill in your keys.

# --- Public Threat Intelligence & Advisory Feeds (zero target contact) ---
# NVD API key for higher CVE search rate limits (50 req/30s vs 5 req/30s)
# Get key: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY="your-nvd-api-key-here"

# GitHub Personal Access Token for GitHub Security Advisories (GHSA) enrichment
# Get token: https://github.com/settings/tokens
# GITHUB_TOKEN="ghp_your-token-here"

# VirusTotal v3 API key for passive domain/IP reputation
# Sign up / key: https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY="your-virustotal-api-key-here"

# GreyNoise Community API key for IP noise & benign RIOT classification
# Sign up / key: https://viz.greynoise.io/account/api-key
# GREYNOISE_API_KEY="your-greynoise-api-key-here"

# urlscan.io API key for strictly passive historical search index lookups
# Sign up / key: https://urlscan.io/user/#settings
# URLSCAN_API_KEY="your-urlscan-api-key-here"

# --- AI Defensive Triage Providers (optional) ---
# Active AI provider: anthropic | ollama | openai_compat | gemini
S1SHELL_AI_PROVIDER="anthropic"

# Optional custom endpoint URL override:
# S1SHELL_AI_BASE_URL=""

# Anthropic (standard inference key sk-ant-api*, NOT admin key sk-ant-admin*)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Local Ollama (air-gapped, zero cloud telemetry — https://ollama.com/download):
# OLLAMA_API_URL="http://127.0.0.1:11434/v1/chat/completions"
# OLLAMA_MODEL="llama3.1:8b"

# OpenAI-compatible provider (OpenAI / vLLM / LiteLLM / OpenRouter)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# OPENAI_API_URL="https://api.openai.com/v1/chat/completions"
# OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
# GEMINI_MODEL="gemini-2.5-flash"
